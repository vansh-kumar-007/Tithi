# Flask settings
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=true

# Swiss Ephemeris path (optional; defaults to ./ephe)
# EPHE_PATH=/path/to/ephe

# Supabase configuration
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret! NEVER expose this in frontend HTML/JS or commit .env to Git.
# Required for permanent account deletion (/api/account/delete).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
