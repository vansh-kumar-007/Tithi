# Flask settings
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=true

# Swiss Ephemeris path (optional; defaults to ./ephe)
# EPHE_PATH=/path/to/ephe

# Supabase configuration
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret! NEVER expose this in frontend HTML/JS or commit .env to Git.
# Required for permanent account deletion (/api/account/delete), server-side entitlements, and Google sync.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Google Calendar OAuth 2.0 & Token Encryption (ALL secrets stay server-side only)
# Production redirect URI: https://tithi-f24b.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-fernet-key
